# Environment for docker-compose.yml. In Dokploy, paste these into the compose service's Environment tab.
# Never commit real values.

# --- Required ---
POSTGRES_PASSWORD=change-me
# Public origin of the site, no trailing slash. Magic links point here and cookies are Secure when it is https.
PUBLIC_BASE_URL=https://peopleforce.site

# --- Email (Resend) ---
# "console" prints the sign-in link to the API log instead of sending mail (development only).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend. Turn OFF click tracking for that domain,
# otherwise Resend rewrites the sign-in link through its own redirect.
EMAIL_FROM=PeopleForce <hello@peopleforce.site>

# --- Content (Sanity) ---
# "local" serves api/content/*.json. "sanity" reads published documents and falls back to local on a cold start.
CONTENT_SOURCE=local
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed for a private dataset.
SANITY_TOKEN=

# --- AI ---
# none | gemini | anthropic
LLM_PROVIDER=none
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: prompt management and tracing. Local prompt files are used when unset or unreachable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region of the Langfuse project: https://us.cloud.langfuse.com (US) or https://cloud.langfuse.com (EU).
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Analytics (PostHog) ---
# The project API key (public by design). Used by the API and baked into the web build.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
