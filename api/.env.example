# Local development for the API (copy to api/.env). See ../.env.example for every option.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://peopleforce:peopleforce@localhost:5433/peopleforce
# Must equal the origin you open the web app on.
PUBLIC_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=console
CONTENT_SOURCE=local
LLM_PROVIDER=none
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
