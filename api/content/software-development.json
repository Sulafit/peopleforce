                "type": "document_review",
                "key": "resume-recheck",
                "title": "Your improved résumé",
                "capability": "resume_review",
                "min_score": 70,
                "asset_type": "resume_review",
                "submit_label": "Upload new version"
              }
            ]
          }
        },
